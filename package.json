{
  "name": "vx-qa",
  "version": "1.0.0",
  "description": "VxSuite QA Automation Tool - Automates election QA testing with VxAdmin and VxScan",
  "keywords": [
    "automation",
    "election",
    "qa",
    "votingworks",
    "vxsuite"
  ],
  "license": "GPL-3.0",
  "author": "VotingWorks",
  "bin": {
    "vx-qa": "src/index.ts"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node src/index.ts",
    "lint": "oxfmt --check && oxlint --type-aware",
    "lint:fix": "oxfmt && oxlint --type-aware --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "canvas": "^3.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "handlebars": "^4.7.8",
    "jszip": "^3.10.1",
    "ora": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^5.0.0",
    "simple-git": "^3.22.0",
    "tree-kill": "^1.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "husky": "^9.1.7",
    "jest-image-snapshot": "^6.5.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxfmt",
      "oxlint --type-aware --fix"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.34.1"
}
